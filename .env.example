APP_NAME=ElectionAI
ENVIRONMENT=development
MODEL_PATH=models/winner_model.joblib
POLLSTER_CALIBRATION_PATH=models/pollster_calibration.joblib
TURNOUT_MODEL_PATH=models/turnout_model.joblib
TRANSFER_MODEL_PATH=models/transfer_model.joblib
POLLS_PATH=data/raw/current_polls.csv
FUNDAMENTALS_PATH=data/raw/current_fundamentals.csv
STATE_PRIORS_PATH=data/raw/state_priors.csv
TURNOUT_PATH=data/raw/current_turnout.csv
DATA_REGISTRY_PATH=data/registry/election_ai.sqlite3
SNAPSHOTS_PATH=data/snapshots
N_SIMULATIONS=50000
POSTERIOR_DRAWS=8000
RANDOM_SEED=42

# Experimental MiroFish layer (off by default)
MIROFISH_BASE_URL=http://localhost:5001
ENABLE_AGENT_SCENARIOS=false
AGENT_SCENARIO_PATH=data/scenarios/mirofish_scenario.json
AGENT_SCENARIO_STRENGTH=0.35
